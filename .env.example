# Copy this file to `.env` (same folder) before running the app.
# `.env` itself is git-ignored — this file is the committed template.
#
# Values are read per-flavor: `KEY_DEV` when running with
# --dart-define=FLAVOR=dev, `KEY_QA` for FLAVOR=qa. If a flavor-specific
# key is missing, EnvironmentConfig falls back to the bare `KEY`.
#
# Both flavors point at the same public DummyJSON API for now — split
# them the day dev/qa need different backends.

BASE_URL_DEV=https://dummyjson.com
BASE_URL_QA=https://dummyjson.com
